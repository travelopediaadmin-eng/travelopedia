# =========================================================================
# The TraveloPedia — Environment Variables Configuration (.env.local)
# Luxury Travel Portal, Email Verification & Admin Notification System
# =========================================================================

# -------------------------------------------------------------------------
# 1. SUPABASE DATABASE & AUTHENTICATION
# Get these from your Supabase Project Settings -> API
# -------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# -------------------------------------------------------------------------
# 2. ADMIN NOTIFICATIONS & EMAIL DELIVERY
# Provider Option A: Resend API (Recommended - https://resend.com)
# -------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here

# Provider Option B: Standard SMTP (Zoho Mail / cPanel SMTP / Brevo / AWS SES)
# If RESEND_API_KEY is not set, system automatically uses SMTP:
SMTP_HOST=mail.thetravelopedia.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=travelo@thetravelopedia.com
SMTP_PASS=your_smtp_password_here

# -------------------------------------------------------------------------
# 3. NOTIFICATION RECIPIENT & SENDER
# -------------------------------------------------------------------------
ADMIN_EMAIL=travelo@thetravelopedia.com
EMAIL_FROM="The TraveloPedia Concierge" <travelo@thetravelopedia.com>

# -------------------------------------------------------------------------
# 4. PRODUCTION WEBSITE URL
# Used for verification links and redirection
# -------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://thetravelopedia.com
