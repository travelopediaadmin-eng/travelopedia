# Sphere OS - Environment Variables Configuration

# Airtable Configuration (Get these from https://airtable.com/create/tokens)
# 1. Create a Personal Access Token with scopes: data.records:read, data.records:write, schema.bases:read
AIRTABLE_API_KEY=pat_your_airtable_personal_access_token_here
AIRTABLE_BASE_ID=app_your_base_id_here

# Cloudflare R2 Storage (Optional for Phase 2: 4K Raw Video Ingest)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=sphere-os-assets

# AI Models (Optional for Phase 3: Automated Brief Writer)
GEMINI_API_KEY=
