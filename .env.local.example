# =========================================================================
# Sphere OS — Environment Variables Configuration (.env.local)
# Copy this file to .env.local and fill in the values for 100% Live Sync.
# (Agar ye khali bhi rahenge, system automatic Mock/Fallback mode mein chalega)
# =========================================================================

# -------------------------------------------------------------------------
# 1. AIRTABLE DATABASE (Master Relational Store for 15 Clients)
# Link: https://airtable.com/create/tokens
# Required Scopes: data.records:read, data.records:write, schema.bases:read
# -------------------------------------------------------------------------
AIRTABLE_API_KEY=pat_your_airtable_token_here
AIRTABLE_BASE_ID=app_your_base_id_here

# -------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI (Brief Generator & Hinglish Voice-to-Task)
# Link: https://aistudio.google.com/app/apikey (Free tier available)
# -------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# -------------------------------------------------------------------------
# 3. CLOUDFLARE R2 STORAGE (Direct 4K Video Uploads - Zero Egress Fees)
# Link: https://dash.cloudflare.com/ -> R2 Object Storage -> Manage R2 API Tokens
# -------------------------------------------------------------------------
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=sphere-os-assets
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://assets.illustrativesphere.com

# -------------------------------------------------------------------------
# 4. META WHATSAPP CLOUD API (Automated Approvals & Voice Notes)
# Link: https://developers.facebook.com/ -> WhatsApp Product
# -------------------------------------------------------------------------
WHATSAPP_TOKEN=your_whatsapp_system_user_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_VERIFY_TOKEN=sphere_os_meta_webhook_2026_secure

# -------------------------------------------------------------------------
# 5. AUTOMATED CHASER CRON SECRET (Security for Hourly Rule Engine)
# Set any random string here (e.g. openssl rand -hex 16)
# -------------------------------------------------------------------------
CRON_SECRET=sphere_os_hourly_cron_secret_key_2026

# -------------------------------------------------------------------------
# 6. APP URL (For Webhooks and Tokenized Client Review Links)
# Local: http://localhost:3000
# Production: https://app.illustrativesphere.com
# -------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
